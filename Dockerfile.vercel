FROM eclipse-temurin:25-jdk-alpine

WORKDIR /app
COPY . .

RUN chmod +x gradlew
RUN ./gradlew build -x test

EXPOSE 8080

# Assume que o nome do seu projeto no Gradle é "api".
# Se for outro nome, ajuste "api-0.0.1-SNAPSHOT.jar" para o nome correto.
CMD ["sh", "-c", "java -jar build/libs/api-0.0.1-SNAPSHOT.jar --server.port=${PORT:-80}"]